#!/usr/bin/env bash
# zorgspeech — standalone voice-to-AI TUI (regmon-re portability pass)
# Records voice, transcribes via whisper, sends to opencode via `opencode run`.
# Standalone: no fossil crew, no gateway, no tmux/zorgstudio coupling.
# Any AI: whatever the user's opencode is configured for (local or cloud).
# Usage: zorgspeech [workdir]
set -uo pipefail

# --- Configuration (all overridable) ---
WAV2MD="${WAV2MD:-wav2md}"
# opencode agent to use. Default "build" (dictation -> act); "plan" to think first.
RE_RUN_AGENT="${RE_RUN_AGENT:-build}"
# opencode executable; override if not on PATH
RE_OPENCODE="${RE_OPENCODE:-opencode}"
# Optional pre-processing hook (replaces the old koda interpreter). If set,
# the transcript is piped through this command before being sent to opencode.
RE_INTERPRET_CMD="${RE_INTERPRET_CMD:-}"
# Audio device. Default: auto-probe for a usable ALSA device.
RE_AUDIO_DEV="${RE_AUDIO_DEV:-}"
WORKDIR="${1:-$PWD}"
EVENT_FILE="/tmp/regmonre_event.$$"

# Audio device: explicit RE_AUDIO_DEV wins; else probe for the first card that
# has a usable capture device. Falls back to "default" if probe fails.
audio_dev() {
    if [ -n "$RE_AUDIO_DEV" ]; then printf '%s' "$RE_AUDIO_DEV"; return; fi
    local dev
    dev=$(arecord -l 2>/dev/null | grep -oE '^card [0-9]+' | head -1 \
          | awk '{print "hw:"$2",0"}')
    printf '%s' "${dev:-default}"
}

# Terminal colors
if tput setaf 1 &>/dev/null; then
    cB=$(tput bold)
    cD=$(tput dim)
    cR=$(tput setaf 1)
    cG=$(tput setaf 2)
    cY=$(tput setaf 3)
    cBL=$(tput setaf 4)
    cM=$(tput setaf 5)
    cC=$(tput setaf 6)
    cW=$(tput setaf 7)
    cN=$(tput sgr0)
else
    cB= cD= cR= cG= cY= cBL= cM= cC= cW= cN=
fi

# State
STATE="idle"
MODE=""  # "instruct" (i) or "direct" (d)
NOTICE=""
REC_PID=""
WAV_FILE=""
MD_FILE=""
START_TIME=""
TRANSCRIBE_PID=""
TRANSCRIBE_START=""
RESET_PID=""

h() { printf '%s' "${cB}$1${cN}"; }
dim() { printf '%s' "${cD}$1${cN}"; }

ZS_SINK=""
zs_sink() {
    [ -z "$ZS_SINK" ] && ZS_SINK=$(pactl get-default-sink 2>/dev/null)
    printf '%s' "$ZS_SINK"
}
mute_speakers() {
    local s; s=$(zs_sink)
    [ -n "$s" ] && pactl set-sink-mute "$s" 1 2>/dev/null || true
}
unmute_speakers() {
    local s; s=$(zs_sink)
    [ -n "$s" ] && pactl set-sink-mute "$s" 0 2>/dev/null || true
}

cleanup() {
    unmute_speakers
    stty echo 2>/dev/null || true
    tput cnorm 2>/dev/null || true
    kill "$REC_PID" "$TRANSCRIBE_PID" "$RESET_PID" 2>/dev/null || true
    rm -f "$EVENT_FILE"
    rm -f /tmp/regmonre_*.wav /tmp/regmonre_*.md 2>/dev/null || true
    # Legacy names from before rename — clean those up too
    rm -f /tmp/zorg_*.wav /tmp/zorg_*.md 2>/dev/null || true
    clear 2>/dev/null || true
    exit 0
}
trap cleanup EXIT INT TERM HUP
trap draw WINCH

draw() {
    tput cup 0 0 2>/dev/null
    case "$STATE" in
        idle)  printf "${cW} /█\\  %s${cN}" "$NOTICE" ;;
        recording_instruct)
            local el=$(( $(date +%s) - START_TIME ))
            printf "${cR}${cB} /█\\  Recording: ${el}s${cN}" ;;
        transcribing)
            local el=$(( $(date +%s) - START_TIME ))
            printf "${cY} /█\\  Transcribing: ${el}s${cN}" ;;
        interpreting)
            local el=$(( $(date +%s) - START_TIME ))
            printf "${cBL} /█\\  Interpreting: ${el}s${cN}" ;;
        done_ok) printf "${cG}${cB} /█\\  %s${cN}" "$NOTICE" ;;
        error)   printf "${cR}${cB} /█\\  %s${cN}" "$NOTICE" ;;
    esac
    printf "\033[K"

    tput cup 1 0 2>/dev/null
    printf "(•┴•) $(h 'i') $(h 'd')"
    printf "\033[K"

    tput cup 2 0 2>/dev/null
    printf "\033[K"
    tput cup 3 0 2>/dev/null
    printf "\033[K"
}

is_recording() {
    [ "$STATE" = "recording_instruct" ]
}

stop_recording() {
    if [ -n "$REC_PID" ]; then
        # Graceful stop: SIGINT flushes the WAV header (blogher's proven
        # method).  A hard SIGTERM can leave a 44-byte header-only WAV (no
        # audio data) which wav2md rejects with 'Transcription failed'.
        # Give it a moment to flush, then force-kill if needed.
        kill -INT "$REC_PID" 2>/dev/null || true
        for _ in $(seq 1 50); do
            kill -0 "$REC_PID" 2>/dev/null || break
            sleep 0.02
        done
        kill "$REC_PID" 2>/dev/null || true
        wait "$REC_PID" 2>/dev/null || true
        REC_PID=""
    fi
}

check_ready() {
    local err=""
    if ! command -v "$RE_OPENCODE" &>/dev/null; then
        err="opencode needed — install opencode (https://opencode.ai)"
    elif ! command -v arecord &>/dev/null; then
        err="arecord needed — sudo apt install alsa-utils"
    elif ! command -v whisper-cli &>/dev/null; then
        err="whisper-cli needed — run ./setup.sh"
    elif ! command -v wav2md &>/dev/null; then
        err="wav2md needed — run ./setup.sh"
    elif [ ! -f "$HOME/.local/share/whisper/models/ggml-medium.bin" ] && \
         [ ! -f "$HOME/.local/share/whisper/models/ggml-small.bin" ]; then
        err="model missing — run ./setup.sh for URL"
    fi
    if [ -n "$err" ]; then
        STATE="error"; NOTICE="$err"; return 1
    fi
    return 0
}

start_instruct() {
    mute_speakers
    kill "$RESET_PID" 2>/dev/null || true; RESET_PID=""
    STATE="recording_instruct"
    local ts=$(date +%Y%m%d_%H%M%S)
    WAV_FILE="/tmp/regmonre_${ts}.wav"
    MD_FILE="/tmp/regmonre_${ts}.md"
    # arecord on the chosen device + SIGINT to stop (flushes the WAV header).
    # Mono 16-bit 16 kHz. Device auto-probed (RE_AUDIO_DEV overrides).
    arecord -q -D "$(audio_dev)" -f "${RE_AUDIO_FMT:-S16_LE}" \
        -r "${RE_AUDIO_RATE:-16000}" -c "${RE_AUDIO_CH:-1}" -t wav "$WAV_FILE" 2>/dev/null &
    REC_PID=$!
    START_TIME=$(date +%s)
}

instruct_stop_and_transcribe() {
    kill "$RESET_PID" 2>/dev/null || true; RESET_PID=""
    stop_recording
    unmute_speakers

    # Silence gate: only discard COMPLETELY silent recordings (max_volume at or
    # below -65 dB, i.e. the recording is essentially digital silence).  Real
    # speech of any length must pass — the earlier tighter gate (-42dB / 0.6s)
    # was discarding genuine voice clips, and the repeated-lines bug it was
    # guarding against is already fixed by the done_ok change.
    if [ -f "$WAV_FILE" ]; then
        local maxdb
        maxdb=$(ffmpeg -i "$WAV_FILE" -af volumedetect -f null - 2>&1 \
                | awk -F: '/max_volume/{gsub(/ /,"",$2); gsub(/dB/,"",$2); print $2}' | head -1)
        if [ -z "$maxdb" ] || [ "$maxdb" = "-inf" ] || \
           awk -v m="$maxdb" 'BEGIN{exit !(m < -65)}'; then
            STATE="idle"
            NOTICE="No audio detected - discarded"
            rm -f "$WAV_FILE"
            return
        fi
    fi

    STATE="transcribing"
    START_TIME=$(date +%s)
    TRANSCRIBE_START=$START_TIME
    (
        if ! [ -f "$WAV_FILE" ]; then
            echo "ERROR:No recording file" > "$EVENT_FILE"
            exit 1
        fi
        if ! command -v "$WAV2MD" &>/dev/null && [ ! -x "$WAV2MD" ]; then
            echo "ERROR:wav2md not found at: $WAV2MD" > "$EVENT_FILE"
            rm -f "$WAV_FILE"
            exit 1
        fi
        if ! "$WAV2MD" "$WAV_FILE" -o "$MD_FILE" 2>/tmp/regmonre_wav2md_err.txt; then
            # Report WHY: wav size + wav2md stderr (not a generic message).
            local wsize
            wsize=$(stat -c%s "$WAV_FILE" 2>/dev/null || echo "?")
            local errmsg
            errmsg=$(head -3 /tmp/regmonre_wav2md_err.txt 2>/dev/null | tr '\n' ' ')
            echo "ERROR:Transcription failed (wav=${wsize}B ${errmsg})" > "$EVENT_FILE"
            rm -f /tmp/regmonre_wav2md_err.txt
            exit 1
        fi
        rm -f /tmp/regmonre_wav2md_err.txt
        # --- Optional pre-processing hook (replaces the old koda interpreter) ---
        if [ -n "$RE_INTERPRET_CMD" ] && command -v "${RE_INTERPRET_CMD%% *}" >/dev/null 2>&1; then
            echo "INTERPRETING" > "$EVENT_FILE"
            INTERP_MD="/tmp/regmonre_interp_$$.md"
            if eval "$RE_INTERPRET_CMD" < "$MD_FILE" > "$INTERP_MD" 2>/dev/null; then
                mv "$INTERP_MD" "$MD_FILE"
            fi
            rm -f "$INTERP_MD"
        fi
        # --- Send to opencode (the AI agent) ---
        local trimmed
        trimmed=$(cat "$MD_FILE")
        if [ -n "$trimmed" ]; then
            # Normalise to a SINGLE line.
            trimmed=$(printf '%s' "$trimmed" | tr '\r\n\t' '   ' \
                | sed 's/  */ /g' | sed 's/^ *//; s/ *$//')
            echo "SENDING" > "$EVENT_FILE"
            local run_out
            run_out=$(mktemp /tmp/regmonre_run_$$.XXXX)
            if ! "$RE_OPENCODE" run --agent "$RE_RUN_AGENT" "$trimmed" > "$run_out" 2>/dev/null; then
                echo "ERROR:opencode run failed (is opencode installed & configured?)" > "$EVENT_FILE"
                rm -f "$run_out"
                exit 1
            fi
            rm -f "$run_out"
        fi
        rm -f "$WAV_FILE" "$MD_FILE" 2>/dev/null
        echo "DONE" > "$EVENT_FILE"
    ) &
    TRANSCRIBE_PID=$!
}

handle_key() {
    local key="$1"

    case "$key" in
        i|I|d|D)
            case "$key" in
                i|I) MODE="instruct" ;;
                d|D) MODE="direct" ;;
            esac
            case "$STATE" in
                idle|error)
                    NOTICE=""
                    check_ready || return
                    start_instruct ;;
                done_ok)
                    # The transcribed text is ALREADY sent to opencode by the
                    # background thread (instruct_stop_and_transcribe) — this D
                    # only needs to return to idle.  Previously this also
                    # started a fresh recording, which caught ambient audio /
                    # silence and fed a loop of repeated lines back into
                    # opencode on every D.  Now: D(record) -> D(stop+send) ->
                    # done_ok -> D(back to idle).  The next D starts a new
                    # recording cleanly.
                    STATE="idle"
                    MODE=""
                    NOTICE="Ready."
                    kill "$RESET_PID" 2>/dev/null || true
                    RESET_PID="" ;;
                recording_instruct) instruct_stop_and_transcribe ;;
                transcribing)      ;;  # ignore during transcribe
                interpreting)      ;;  # ignore during interpreter
            esac ;;
        *)
            if [ "$STATE" = "done_ok" ]; then
                STATE="idle"
                NOTICE="Ready."
                kill "$RESET_PID" 2>/dev/null || true
                RESET_PID=""
            fi ;;
    esac
}

check_event() {
    if [ -f "$EVENT_FILE" ]; then
        local ev
        ev=$(<"$EVENT_FILE")
        rm -f "$EVENT_FILE"
        TRANSCRIBE_PID=""
        case "$ev" in
            ERROR:*)
                STATE="error"
                TRANSCRIBE_START=""
                NOTICE="${ev#ERROR:}" ;;
            INTERPRETING)
                STATE="interpreting" ;;
            SENDING)
                STATE="transcribing"
                NOTICE="Sending to opencode…" ;;
            DONE)
                STATE="done_ok"
                TRANSCRIBE_START=""
                local el=$(( $(date +%s) - START_TIME ))
                NOTICE="Done. D again to clear" ;;
            RESET)
                STATE="idle"; NOTICE="Ready."; RESET_PID="" ;;
        esac
    fi
}

main() {
    cd "$WORKDIR"
    local orig_tty
    orig_tty=$(tty 2>/dev/null || true)
    tput civis 2>/dev/null || true
    local key rc
    while true; do
        if [ -n "$orig_tty" ] && [ ! -c "$orig_tty" ]; then
            break
        fi
        draw
        check_event
        # Transcription watchdog: if wav2md hangs, never leave 'transcribing'.
        # Force a reset back to idle after TRANSCRIBE_TIMEOUT seconds.
        if { [ "$STATE" = "transcribing" ] || [ "$STATE" = "interpreting" ]; } \
           && [ -n "$TRANSCRIBE_PID" ]; then
            local now start el
            now=$(date +%s)
            start="${TRANSCRIBE_START:-$now}"
            el=$(( now - start ))
            if [ $el -gt "${TRANSCRIBE_TIMEOUT:-120}" ]; then
                kill "$TRANSCRIBE_PID" 2>/dev/null || true
                TRANSCRIBE_PID=""; TRANSCRIBE_START=""
                STATE="idle"; NOTICE="Transcription timed out — reset."
            fi
        fi
        # -N 1 (capital N) reads exactly one character including newline,
        # unlike -n 1 which treats newline as a line delimiter and discards it.
        IFS= read -t 0.1 -N 1 -s key 2>/dev/null; rc=$?
        if [ $rc -eq 0 ]; then
            # Esc (0x1b) aborts recording OR a hung transcription.
            if [ "$key" = $'\e' ]; then
                if [ "$STATE" = "transcribing" ] || [ "$STATE" = "interpreting" ]; then
                    kill "$TRANSCRIBE_PID" 2>/dev/null || true
                    TRANSCRIBE_PID=""; TRANSCRIBE_START=""
                    STATE="idle"; NOTICE="Aborted."
                elif [ "$STATE" = "recording_instruct" ]; then
                    stop_recording
                    STATE="idle"; NOTICE="Cancelled."
                fi
                continue
            fi
            # Standalone: no interactive tmux pane to forward Enter to — the
            # transcript goes via `opencode run`.  Enter just acknowledges.
            handle_key "$key"
        elif [ $rc -ne 142 ]; then
            break
        fi
    done
    cleanup
}

main
